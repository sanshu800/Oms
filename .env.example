# Local API
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Hosts and origins: APP_URL is the *API*, not the dashboard you browse.
#
# APP_URL  = public origin that serves this API, and therefore the origin
#            Shopify delivers to: <APP_URL>/webhooks/shopify. It must be
#            stable per environment, because the URI is stored on Shopify's
#            side (a dead one is retried ~48h and then deleted).
# APP_DOMAIN = the registrable domain APP_URL must live under. It is policy,
#            not routing: it makes APP_URL validation ("https, not a tunnel,
#            ours") possible and lets the registration script recognise this
#            app's subscriptions on a store.
#
# The dashboard is a separate, host-agnostic process with no URL variable of
# its own: point any hostname at port 3000 and it works. Its rewrites forward
# /api/* (browser calls) and /webhooks/* (Shopify deliveries) to
# API_SERVER_URL, so in development one host can serve everything.
#
#   local (no public host)   APP_URL=http://localhost:4000
#                            APP_DOMAIN unset; webhooks replayed locally
#   dev on your domain       APP_URL=https://oms.reygent.com        ← one host:
#                            APP_DOMAIN=reygent.com                   dashboard +
#                            (dashboard rewrites /webhooks/shopify)   webhooks
#   staging                  APP_URL=https://api-staging.reygent.com
#                            APP_DOMAIN=reygent.com
#   production               APP_URL=https://api.reygent.com
#                            APP_DOMAIN=reygent.com
#
# Details and the full walkthrough: docs/SHOPIFY-CONNECT.md ("Hosts and origins").
APP_URL=http://localhost:4000
APP_DOMAIN=
# ---------------------------------------------------------------------------

# DATABASE_URL is the migration/schema-owner connection. The Prisma CLI
# also needs it to resolve the schema (prisma.config.ts loads .env).
DATABASE_URL=postgresql://techmart:techmart_dev_password@localhost:5432/techmart?schema=public
# Runtime connection must use the restricted, non-superuser role for RLS.
APP_DATABASE_URL=postgresql://techmart_app:techmart_app_dev_password@localhost:5432/techmart?schema=public

# BullMQ uses this URL directly (redis:// or rediss://).
REDIS_URL=redis://localhost:6379

# Shopify drops webhook deliveries it cannot acknowledge within 5s. If the
# queue is unreachable the API stores the delivery, marks it FAILED and
# answers 503 (so Shopify retries) instead of hanging past that limit.
WEBHOOK_ENQUEUE_TIMEOUT_MS=4000

# Replace these before using real Shopify OAuth/webhooks or production.
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters-long
ENCRYPTION_KEY=replace-with-a-local-encryption-secret-at-least-32-characters

# Optional in development/test; required in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_inventory
# Signing secret for stores that have no per-store secret stored.
#   Route A (OAuth app): leave this as the app's client secret — one app
#     signs every store that installs it.
#   Route B (custom app): prefer `connect-shopify-store.ts --webhook-secret=…`,
#     which stores that store's API secret key encrypted. This variable is
#     then only a fallback, and a second custom app needs its own.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WRITE_SCOPES=write_orders

# Default shop used by the webhook tooling (registration + replay).
#   SHOPIFY_SHOP_DOMAIN=techmart-lab.myshopify.com
SHOPIFY_SHOP_DOMAIN=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

AI_INVESTIGATION_MAX_TOOL_CALLS=8
AI_INVESTIGATION_TIMEOUT_MS=60000
AI_INVESTIGATION_MAX_TOKENS=20000
