generator client {
  provider = "prisma-client-js"
  // "client" runs queries through Prisma's WASM query compiler plus a
  // driver adapter (see src/prisma/prisma.service.ts), so no native
  // query engine binary has to be downloaded or shipped.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  // Kept for schema/config resolution only: migrations and the running
  // client both get their connection from a driver adapter (see
  // prisma.config.ts and src/prisma/prisma.service.ts), so Prisma warns
  // that this value is unused. It stays because Prisma 6.x requires a
  // resolvable datasource url to load the schema at all — and without
  // it the CLI falls back to the native-engine code path.
  url = env("DATABASE_URL")
}

enum StorePlatform {
  SHOPIFY
  AMAZON
  WOOCOMMERCE
  EBAY
  OTHER
}

enum StoreConnectionStatus {
  PENDING
  ACTIVE
  DISCONNECTED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  READY_TO_FULFILL
  FULFILLING
  FULFILLED
  CANCELLED
  FAILED
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum ExceptionSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AuditActorType {
  SYSTEM
  USER
  INTEGRATION
  AI_AGENT
}

enum AiInvestigationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AiDecisionBasis {
  TENANT_HISTORY
  POOLED_PRIOR
  HEURISTIC
}

enum AiRiskTier {
  LOW
  MEDIUM
  HIGH
}

enum AiDecisionProposalStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  EXECUTION_FAILED
}

enum AiOutcome {
  APPROVED
  REJECTED
  EDITED
}

enum AiAutonomyLevel {
  RECOMMEND_ONLY
  AUTO_BELOW_THRESHOLD
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
  SHIPPED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVATION
  RELEASE
  COMMIT
  SHIP
  TRANSFER_IN
  TRANSFER_OUT
}

enum FulfillmentStatus {
  READY
  IN_PROGRESS
  PARTIALLY_FULFILLED
  FULFILLED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  CREATED
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores        StoreConnection[]
  webhookEvents WebhookEvent[]
  orders        ShopifyOrderSnapshot[]
  omsOrders     Order[]
  exceptions    OperationalException[]
  auditEvents   AuditEvent[]

  inventoryItems        InventoryItem[]
  inventoryLocations    InventoryLocation[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]

  inventoryItemExternalReferences     InventoryItemExternalReference[]
  inventoryLocationExternalReferences InventoryLocationExternalReference[]

  fulfillments Fulfillment[]
  shipments    Shipment[]

  aiInvestigations    AiInvestigation[]
  aiDecisionProposals AiDecisionProposal[]
  aiMemoryFacts       AiMemoryFact[]
  aiAutonomyPolicies  AiAutonomyPolicy[]

  apiKeys TenantApiKey[]
}

//
// ============================================================
// TENANT API KEYS
// ============================================================
//
// The only mechanism by which a caller is trusted to act as a given
// tenant. tenantId is NEVER accepted as a client-supplied query/body
// value on protected endpoints — it is resolved server-side from the
// authenticated key. Only the hash is stored; the raw key is shown to
// the merchant exactly once (at creation) and cannot be recovered.
//

model TenantApiKey {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label     String
  hashedKey String @unique

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tenantId])
}

model StoreConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  platform        StorePlatform

  /// Neutral external store identity (locked decision 5): the id the
  /// channel itself uses for this store — for Shopify, the shop domain
  /// (`techmart-lab.myshopify.com`), which is what its webhook deliveries
  /// and OAuth flows name. Inbound deliveries resolve to a StoreConnection
  /// through (platform, externalStoreId); nothing else may be used as the
  /// store identity at the boundary.
  externalStoreId String

  status StoreConnectionStatus @default(PENDING)

  encryptedAccessToken String?
  /// The app secret that signs this store's webhook deliveries.
  /// Null falls back to the deployment-wide SHOPIFY_WEBHOOK_SECRET, which
  /// is correct for an OAuth app (one secret, every store that installs it)
  /// and wrong for custom apps (each admin-created app has its own secret,
  /// so a second store would have its deliveries rejected).
  encryptedWebhookSecret String?
  scopes                 String[] @default([])

  installedAt    DateTime?
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]
  orders        ShopifyOrderSnapshot[]
  omsOrders     Order[]
  exceptions    OperationalException[]

  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]

  inventoryItemExternalReferences     InventoryItemExternalReference[]
  inventoryLocationExternalReferences InventoryLocationExternalReference[]

  fulfillments Fulfillment[]
  shipments    Shipment[]

  @@unique([platform, externalStoreId])
  @@index([tenantId, status])
}

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  topic String

  /// The channel's id for this delivery (locked decision 6). Idempotency
  /// key: a duplicate delivery of the same event is acknowledged without
  /// re-queueing.
  externalEventId String

  payload       Json
  payloadSha256 String

  status WebhookStatus @default(RECEIVED)

  attempts Int @default(0)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  lastError String?

  @@unique([storeId, externalEventId])
  @@index([tenantId, storeId, status, receivedAt])
}

model ShopifyOrderSnapshot {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  shopifyOrderId String
  orderName      String

  financialStatus   String
  fulfillmentStatus String

  raw Json

  createdAtShopify DateTime
  updatedAtShopify DateTime

  receivedAt DateTime @default(now())

  @@unique([storeId, shopifyOrderId])
  @@index([tenantId, storeId, fulfillmentStatus])
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  externalOrderId String
  orderNumber     String

  status OrderStatus @default(NEW)

  paymentStatus     String
  fulfillmentStatus String

  totalAmount Decimal @db.Decimal(12, 2)
  currency    String

  orderedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OrderItem[]
  reservations InventoryReservation[]
  fulfillments Fulfillment[]

  @@unique([storeId, externalOrderId])
  @@index([tenantId, storeId, status])
  @@index([tenantId, storeId, updatedAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * Canonical TechMart inventory identity.
   * This connects an order line from any channel
   * to the canonical InventoryItem.
   */
  inventoryItemId String? @db.Uuid

  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /**
   * External line-item identity from the originating platform.
   */
  externalLineItemId String

  /**
   * The channel's catalog-item reference for this line (e.g. the channel
   * variant/inventory-item id), when the payload carries one. Primary key
   * for canonical inventory resolution via
   * InventoryItemExternalReference (see
   * src/oms/inventory/canonical-mapping.ts for the full rule).
   */
  externalItemRef String?

  /**
   * Keep the original SKU observed from the channel
   * as operational evidence.
   */
  sku   String
  title String

  quantity Int

  unitPrice Decimal? @db.Decimal(12, 2)

  reservations InventoryReservation[]

  fulfillmentItems FulfillmentItem[]
  shipmentItems    ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, externalLineItemId])
  @@index([inventoryItemId])
}

//
// ============================================================
// CANONICAL INVENTORY
// ============================================================
//
// IMPORTANT:
//
// InventoryItem is NOT owned by Shopify/Amazon/eBay.
//
// It is the merchant's canonical product/inventory identity.
//
// Example:
//
// TechMart SKU-001
//       |
//       +---- Shopify SKU ABC
//       +---- Amazon ASIN XYZ
//       +---- eBay SKU 123
//
// All channels point to the same InventoryItem.
//

model InventoryItem {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * Canonical merchant SKU.
   * Unique across the merchant/tenant,
   * NOT per sales channel.
   */
  sku  String
  name String

  active Boolean @default(true)

  /**
   * Inventory is physically distributed across locations.
   */
  balances InventoryBalance[]

  orderItems OrderItem[]

  reservations InventoryReservation[]

  fulfillmentItems FulfillmentItem[]

  movements InventoryMovement[]

  externalReferences InventoryItemExternalReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Canonical SKU uniqueness is tenant-wide.
   */
  @@unique([tenantId, sku])
  @@index([tenantId, active])
}

//
// ============================================================
// PHYSICAL INVENTORY LOCATION
// ============================================================
//
// Examples:
//
// Warehouse A
// Warehouse B
// 3PL Warehouse
// Retail Store
// Dropship location
//
// A location is canonical for the merchant.
//
// Platform-specific location IDs are handled separately
// through InventoryLocationExternalReference.
//

model InventoryLocation {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code String
  name String

  active Boolean @default(true)

  /**
   * Stock held at this physical location.
   */
  balances InventoryBalance[]

  reservations InventoryReservation[]

  fulfillments Fulfillment[]

  movements InventoryMovement[]

  externalReferences InventoryLocationExternalReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Location code is unique for the merchant,
   * not per sales channel.
   */
  @@unique([tenantId, code])
  @@index([tenantId, active])
}

//
// ============================================================
// INVENTORY BALANCE
// ============================================================
//
// This is the actual stock position:
//
// Canonical SKU + Physical Location
//
// Example:
//
// SKU-001 + Warehouse A = 10
// SKU-001 + Warehouse B = 25
//
// Total canonical inventory = 35
//

model InventoryBalance {
  id String @id @default(uuid()) @db.Uuid

  inventoryItemId String @db.Uuid
  locationId      String @db.Uuid

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  availableQty Int @default(0)
  reservedQty  Int @default(0)
  committedQty Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * One balance per canonical SKU per physical location.
   */
  @@unique([inventoryItemId, locationId])
  @@index([locationId])
}

//
// ============================================================
// INVENTORY RESERVATION
// ============================================================
//
// Reservation is an operational decision:
//
// Order X
//     |
//     +-- SKU-001
//           |
//           +-- Warehouse B
//           +-- quantity 5
//
// It remains store/channel aware because the reservation
// originated from a particular order/channel.
//

model InventoryReservation {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  orderId     String @db.Uuid
  orderItemId String @db.Uuid

  inventoryItemId String @db.Uuid
  locationId      String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  quantity Int

  status InventoryReservationStatus @default(ACTIVE)

  fulfillmentItems FulfillmentItem[]

  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, storeId, status])
  @@index([orderId, status])
  @@index([inventoryItemId, status])
  @@index([locationId, status])
}

//
// ============================================================
// INVENTORY MOVEMENT LEDGER
// ============================================================
//
// Every material inventory mutation gets recorded here.
//
// This becomes important later for:
// - discrepancy detection
// - root-cause investigation
// - reconciliation
// - auditability
// - AI evidence
//

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  inventoryItemId String @db.Uuid
  locationId      String @db.Uuid

  orderId       String? @db.Uuid
  orderItemId   String? @db.Uuid
  reservationId String? @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  type InventoryMovementType

  quantity Int

  reference String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId, storeId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([locationId, createdAt])
  @@index([orderId, createdAt])
  @@index([reservationId])
}

//
// ============================================================
// FULFILLMENT
// ============================================================
//
// Fulfillment represents the operational execution unit
// created from one or more inventory reservations.
//
// IMPORTANT:
// - Fulfillment does NOT allocate inventory.
// - Fulfillment does NOT own inventory quantities.
// - Fulfillment consumes existing reservations.
// - One Order may have multiple Fulfillments.
// - Each Fulfillment belongs to one physical location.
//

model Fulfillment {
  id String @id @default(uuid()) @db.Uuid

  tenantId   String @db.Uuid
  storeId    String @db.Uuid
  orderId    String @db.Uuid
  locationId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  status FulfillmentStatus @default(READY)

  /**
   * External fulfillment identity.
   * Nullable because internally-created fulfillments
   * do not necessarily have an external platform ID.
   */
  externalFulfillmentId String?

  items FulfillmentItem[]

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, externalFulfillmentId])
  @@index([tenantId, storeId, status])
  @@index([orderId, status])
  @@index([locationId, status])
}

//
// ============================================================
// FULFILLMENT ITEM
// ============================================================
//
// Bridges:
//
// OrderItem
//     ?
// InventoryReservation
//     ?
// Fulfillment
//
// Quantity here represents the quantity committed
// to this fulfillment execution unit.
//

model FulfillmentItem {
  id String @id @default(uuid()) @db.Uuid

  fulfillmentId   String @db.Uuid
  orderItemId     String @db.Uuid
  reservationId   String @db.Uuid
  inventoryItemId String @db.Uuid

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  reservation InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity Int

  shipmentItems ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * A reservation can only belong to one fulfillment item.
   */
  @@unique([reservationId])
  @@index([orderItemId])
  @@index([reservationId])
  @@index([inventoryItemId])
}

//
// ============================================================
// SHIPMENT
// ============================================================
//
// Shipment represents the physical outbound movement
// of fulfilled inventory.
//
// Fulfillment owns execution.
// Shipment owns physical shipment state.
//

model Shipment {
  id String @id @default(uuid()) @db.Uuid

  tenantId      String @db.Uuid
  storeId       String @db.Uuid
  fulfillmentId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  status ShipmentStatus @default(CREATED)

  /**
   * External shipment identity.
   */
  externalShipmentId String?

  carrier String?
  service String?

  trackingNumber String?
  trackingUrl    String?

  shippedAt   DateTime?
  deliveredAt DateTime?

  items ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Prevent duplicate external shipments
   * within the same store.
   */
  @@unique([storeId, externalShipmentId])
  @@index([tenantId, storeId, status])
  @@index([fulfillmentId, status])
  @@index([trackingNumber])
}

//
// ============================================================
// SHIPMENT ITEM
// ============================================================
//
// Represents the quantity of a fulfillment item
// physically contained in a shipment.
//
// Supports partial shipments:
//
// Fulfillment = 15
// Shipment A  = 10
// Shipment B  = 5
//

model ShipmentItem {
  id String @id @default(uuid()) @db.Uuid

  shipmentId        String @db.Uuid
  fulfillmentItemId String @db.Uuid
  orderItemId       String @db.Uuid

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fulfillmentItem FulfillmentItem @relation(fields: [fulfillmentItemId], references: [id], onDelete: Restrict)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([fulfillmentItemId])
  @@index([orderItemId])
}

//
// ============================================================
// CHANNEL ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¾ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ CANONICAL INVENTORY MAPPING
// ============================================================
//
// Example:
//
// Shopify:
//   product variant ID = 987654
//
// Amazon:
//   ASIN = B123456
//
// eBay:
//   SKU = EB-001
//
// All can map to:
//
// TechMart InventoryItem:
//   SKU-001
//

model InventoryItemExternalReference {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  inventoryItemId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  platform   StorePlatform
  externalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * A platform identifier can only map to one
   * canonical inventory item within a store.
   */
  @@unique([storeId, platform, externalId])
  /**
   * A canonical item can have one mapping per platform/store.
   */
  @@unique([storeId, inventoryItemId, platform])
  @@index([tenantId, storeId, platform])
}

//
// ============================================================
// CHANNEL / 3PL ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¾ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ CANONICAL LOCATION MAPPING
// ============================================================
//
// Example:
//
// Shopify Location ID
// Amazon fulfillment location
// 3PL warehouse ID
//
// All can map to:
//
// TechMart:
//   WAREHOUSE-1
//

model InventoryLocationExternalReference {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  locationId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  platform   StorePlatform
  externalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * One external platform location maps to one
   * canonical location within a store.
   */
  @@unique([storeId, platform, externalId])
  /**
   * One canonical location can have one mapping
   * per platform/store.
   */
  @@unique([storeId, locationId, platform])
  @@index([tenantId, storeId, platform])
}

//
// ============================================================
// OPERATIONAL EXCEPTIONS
// ============================================================
//

model OperationalException {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  storeId  String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  store StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /**
   * Deterministic identity for the exception.
   */
  fingerprint String

  category String

  severity ExceptionSeverity

  status ExceptionStatus @default(OPEN)

  title String

  /**
   * Evidence used to establish the exception.
   */
  evidence Json

  /**
   * Deterministic/recommended operational action.
   */
  recommendedNextStep String

  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resolvedAt DateTime?

  aiInvestigations    AiInvestigation[]
  aiDecisionProposals AiDecisionProposal[]

  @@unique([storeId, fingerprint])
  @@index([tenantId, storeId, status, severity, detectedAt])
}

//
// ============================================================
// AUDIT EVENT
// ============================================================
//

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  storeId String @db.Uuid

  action    String
  actorType AuditActorType
  actorId   String?

  entityType String
  entityId   String

  metadata Json?

  occurredAt DateTime @default(now())

  @@index([tenantId, occurredAt])
}

//
// ============================================================
// AI INTELLIGENCE LAYER
// ============================================================
//
// IMPORTANT:
//
// The deterministic OMS/exception engine above establishes facts.
// Everything below is AI interpretation of those facts. AI is never
// the source of truth for operational state — it reads it, gathers
// more of it through tools, and proposes a structured decision.
//
// AiDecisionProposal is deliberately never free text: actionType +
// params is what gets executed; reasoningSummary is a byproduct for
// humans to read, not the thing itself.
//

model AiInvestigation {
  id String @id @default(uuid()) @db.Uuid

  tenantId    String @db.Uuid
  storeId     String @db.Uuid
  exceptionId String @db.Uuid

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exception OperationalException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  status AiInvestigationStatus @default(RUNNING)

  model         String
  toolCallCount Int    @default(0)
  tokensUsed    Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  error String?

  toolCalls AiToolCall[]
  proposals AiDecisionProposal[]

  @@index([tenantId, storeId, status])
  @@index([exceptionId])
}

//
// Append-only trace of every tool call made during one investigation.
// This is the agent's "working memory" for that session — kept, not
// discarded, so a human can audit exactly what evidence the agent saw.
//

model AiToolCall {
  id String @id @default(uuid()) @db.Uuid

  investigationId String @db.Uuid

  investigation AiInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  sequence Int
  toolName String

  input  Json
  output Json

  createdAt DateTime @default(now())

  @@index([investigationId, sequence])
}

//
// The structured decision an investigation produces.
// This is what "AI takes action" ultimately means: a proposal that
// is either recommend-only (human approves) or, in later phases,
// auto-executed once a tenant/action-type has earned that autonomy.
//

model AiDecisionProposal {
  id String @id @default(uuid()) @db.Uuid

  tenantId        String @db.Uuid
  storeId         String @db.Uuid
  exceptionId     String @db.Uuid
  investigationId String @db.Uuid

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exception     OperationalException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  investigation AiInvestigation      @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  actionType       String
  targetEntityType String
  targetEntityId   String

  params Json

  confidence Float
  basis      AiDecisionBasis
  riskTier   AiRiskTier

  reasoningSummary String
  evidenceRefs     Json

  status AiDecisionProposalStatus @default(PROPOSED)

  createdAt DateTime  @default(now())
  decidedAt DateTime?
  decidedBy String?

  feedback AiOutcomeFeedback[]

  @@index([tenantId, storeId, status])
  @@index([exceptionId])
  @@index([investigationId])
}

//
// Learning-loop input: what a human did with a proposal, and
// (optionally) what actually happened afterward. This is what lets
// the system calibrate confidence over time instead of staying a
// stateless scorer.
//

model AiOutcomeFeedback {
  id String @id @default(uuid()) @db.Uuid

  proposalId String @db.Uuid

  proposal AiDecisionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  outcome        AiOutcome
  actorId        String?
  note           String?
  observedResult Json?

  createdAt DateTime @default(now())

  @@index([proposalId])
}

//
// Semantic memory: standing, tenant-scoped facts learned from past
// investigations/outcomes. Facts are superseded, not just appended,
// so the system's beliefs can be revised as evidence changes.
//

model AiMemoryFact {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category   String
  fact       String
  confidence Float

  sourceInvestigationId String?

  supersedesId String?       @unique @db.Uuid
  supersedes   AiMemoryFact? @relation("AiMemoryFactSupersedes", fields: [supersedesId], references: [id])
  supersededBy AiMemoryFact? @relation("AiMemoryFactSupersedes")

  createdAt       DateTime @default(now())
  lastConfirmedAt DateTime @default(now())

  @@index([tenantId, category])
}

//
// Governance config: per-tenant, per-action-type autonomy policy.
// Created now, enforced starting Phase 7 — every proposal in Phase 5
// is recommend-only regardless of what this table says.
//

model AiAutonomyPolicy {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actionType String

  autonomyLevel       AiAutonomyLevel @default(RECOMMEND_ONLY)
  confidenceThreshold Float           @default(0.9)
  maxActionsPerHour   Int             @default(0)
  enabled             Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, actionType])
}
